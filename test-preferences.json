{
  "backend": {
    "tool": "pytest",
    "gate": null,
    "additionalTools": ["pytest-mock", "pytest-asyncio", "httpx"],
    "e2eTool": "none",
    "testDir": "backend/tests",
    "filePattern": "test_*.py",
    "packageManager": "pip"
  },
  "frontend": {
    "tool": "vitest",
    "gate": null,
    "additionalTools": ["@testing-library/react", "@testing-library/user-event", "@testing-library/jest-dom", "jsdom"],
    "e2eTool": "none",
    "testDir": "beside source",
    "filePattern": "*.test.ts / *.test.tsx",
    "packageManager": "npm"
  }
}
